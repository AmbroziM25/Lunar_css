{
  "name": "@velo0-0/lunara-css",
  "version": "1.2.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "A lightweight, utility-first CSS framework with a dark \"night sky\" aesthetic — pure CSS, zero build step, with a Tailwind preset for drop-in integration.",
  "main": "dist/lunar.css",
  "style": "dist/lunar.css",
  "unpkg": "dist/lunar.min.css",
  "jsdelivr": "dist/lunar.min.css",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/lunar.css",
    "./min": "./dist/lunar.min.css",
    "./lunar.css": "./dist/lunar.css",
    "./lunar.min.css": "./dist/lunar.min.css",
    "./dist/lunar.css": "./dist/lunar.css",
    "./dist/lunar.min.css": "./dist/lunar.min.css",
    "./bootstrap": "./dist/lunar-bootstrap.css",
    "./bootstrap.css": "./dist/lunar-bootstrap.css",
    "./bootstrap.min.css": "./dist/lunar-bootstrap.min.css",
    "./dist/lunar-bootstrap.css": "./dist/lunar-bootstrap.css",
    "./dist/lunar-bootstrap.min.css": "./dist/lunar-bootstrap.min.css",
    "./tailwind": "./tailwind.css",
    "./tailwind.css": "./tailwind.css",
    "./tailwind-preset": "./tailwind-preset.js",
    "./tailwind-plugin": "./tailwind-plugin.js",
    "./theme": "./theme.mjs",
    "./theme.mjs": "./theme.mjs",
    "./server": "./compiler/dist/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "lunara": "compiler/dist/serve.js"
  },
  "files": [
    "dist",
    "tailwind.css",
    "tailwind-preset.js",
    "tailwind-plugin.js",
    "theme.mjs",
    "compiler/dist",
    "compiler/package.json"
  ],
  "scripts": {
    "build": "node build.js",
    "build:compiler": "tsc -p compiler/tsconfig.build.json",
    "typecheck": "tsc -p compiler/tsconfig.json",
    "test": "node --test \"compiler/tests/*.test.ts\"",
    "prepublishOnly": "node build.js && npm run build:compiler && npm test"
  },
  "keywords": [
    "css",
    "css-framework",
    "utility-first",
    "tailwind",
    "tailwindcss",
    "dark-mode",
    "dark-theme",
    "design-system",
    "ui-kit",
    "glassmorphism",
    "no-build",
    "lunara",
    "react",
    "nextjs",
    "vue",
    "angular",
    "framework-agnostic"
  ],
  "author": "AmbroziM25",
  "license": "MIT",
  "homepage": "https://lunaracss.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmbroziM25/Lunara_css.git"
  },
  "bugs": {
    "url": "https://github.com/AmbroziM25/Lunara_css/issues"
  },
  "peerDependencies": {
    "tailwindcss": ">=3.4.0",
    "lightningcss": ">=1.30.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    },
    "lightningcss": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "lightningcss": "^1.32.0",
    "typescript": "^5.9.3"
  }
}
