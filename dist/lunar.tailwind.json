{
  "base": {
    ":root": {
      "color-scheme": "dark",
      "--moon-50": "#f7f8fc",
      "--moon-100": "#eceef7",
      "--moon-200": "#d9dcee",
      "--moon-300": "#b9bfdd",
      "--moon-400": "#9298bd",
      "--moon-500": "#6f76a0",
      "--moon-600": "#545a80",
      "--moon-700": "#3d4163",
      "--moon-800": "#262844",
      "--moon-900": "#14152a",
      "--moon-950": "#090913",
      "--indigo-400": "#818cf8",
      "--indigo-500": "#6366f1",
      "--indigo-600": "#4f46e5",
      "--violet-400": "#a78bfa",
      "--violet-500": "#8b5cf6",
      "--violet-600": "#7c3aed",
      "--silver-300": "#d7dbea",
      "--silver-400": "#b7bcd6",
      "--eclipse": "#0d0e1f",
      "--glow": "#e4e8ff",
      "--tide": "#6c6ff0",
      "--lunar-bg": "var(--moon-950)",
      "--lunar-bg-elevated": "var(--moon-900)",
      "--lunar-surface": "var(--moon-800)",
      "--lunar-surface-hover": "var(--moon-700)",
      "--lunar-border": "var(--moon-700)",
      "--lunar-text": "var(--moon-50)",
      "--lunar-text-muted": "var(--moon-400)",
      "--lunar-accent": "var(--tide)",
      "--lunar-accent-2": "var(--violet-500)",
      "--space-0": "0",
      "--space-px": "1px",
      "--space-1": "0.25rem",
      "--space-2": "0.5rem",
      "--space-3": "0.75rem",
      "--space-4": "1rem",
      "--space-5": "1.25rem",
      "--space-6": "1.5rem",
      "--space-7": "1.75rem",
      "--space-8": "2rem",
      "--space-9": "2.25rem",
      "--space-10": "2.5rem",
      "--space-12": "3rem",
      "--space-14": "3.5rem",
      "--space-16": "4rem",
      "--space-20": "5rem",
      "--space-24": "6rem",
      "--space-32": "8rem",
      "--font-sans": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Roboto, Helvetica, Arial, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\"",
      "--font-mono": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace",
      "--text-xs": "0.75rem",
      "--text-sm": "0.875rem",
      "--text-base": "1rem",
      "--text-lg": "1.125rem",
      "--text-xl": "1.25rem",
      "--text-2xl": "1.5rem",
      "--text-3xl": "1.875rem",
      "--text-4xl": "2.25rem",
      "--text-5xl": "3rem",
      "--text-6xl": "3.75rem",
      "--leading-none": "1",
      "--leading-tight": "1.25",
      "--leading-snug": "1.375",
      "--leading-normal": "1.5",
      "--leading-relaxed": "1.625",
      "--leading-loose": "2",
      "--tracking-tight": "-0.02em",
      "--tracking-normal": "0",
      "--tracking-wide": "0.02em",
      "--tracking-wider": "0.05em",
      "--font-thin": "100",
      "--font-light": "300",
      "--font-normal": "400",
      "--font-medium": "500",
      "--font-semibold": "600",
      "--font-bold": "700",
      "--font-black": "900",
      "--radius-none": "0",
      "--radius-sm": "0.25rem",
      "--radius-md": "0.5rem",
      "--radius-lg": "0.75rem",
      "--radius-xl": "1rem",
      "--radius-2xl": "1.5rem",
      "--radius-full": "9999px",
      "--shadow-sm": "0 1px 2px 0 rgb(0 0 0 / 0.35)",
      "--shadow-md": "0 4px 12px -2px rgb(0 0 0 / 0.45), 0 2px 4px -2px rgb(0 0 0 / 0.3)",
      "--shadow-lg": "0 12px 24px -4px rgb(0 0 0 / 0.5), 0 4px 8px -4px rgb(0 0 0 / 0.35)",
      "--shadow-xl": "0 24px 48px -8px rgb(0 0 0 / 0.55), 0 8px 16px -8px rgb(0 0 0 / 0.4)",
      "--lunar-moonlight": "1",
      "--glow-color-sm": "rgb(228 232 255 / calc(0.25 * var(--lunar-moonlight)))",
      "--glow-color-md": "rgb(108 111 240 / calc(0.35 * var(--lunar-moonlight)))",
      "--glow-color-lg": "rgb(108 111 240 / calc(0.45 * var(--lunar-moonlight)))",
      "--glow-color-violet": "rgb(139 92 246 / calc(0.45 * var(--lunar-moonlight)))",
      "--shadow-glow-sm": "0 0 12px 0 var(--glow-color-sm)",
      "--shadow-glow-md": "0 0 24px 2px var(--glow-color-md)",
      "--shadow-glow-lg": "0 0 48px 6px var(--glow-color-lg)",
      "--shadow-glow-violet": "0 0 32px 4px var(--glow-color-violet)",
      "--ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "--ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
      "--duration-fast": "150ms",
      "--duration-base": "250ms",
      "--duration-slow": "450ms",
      "--z-dropdown": "100",
      "--z-sticky": "200",
      "--z-overlay": "300",
      "--z-modal": "400",
      "--z-toast": "500",
      "--z-tooltip": "600"
    },
    ":root,\n[data-theme=\"dark\"]": {
      "color-scheme": "dark",
      "--lunar-bg": "var(--moon-950)",
      "--lunar-bg-elevated": "var(--moon-900)",
      "--lunar-surface": "var(--moon-800)",
      "--lunar-surface-hover": "var(--moon-700)",
      "--lunar-border": "var(--moon-700)",
      "--lunar-text": "var(--moon-50)",
      "--lunar-text-muted": "var(--moon-400)",
      "--lunar-accent": "var(--tide)",
      "--lunar-accent-2": "var(--violet-500)"
    },
    "[data-theme=\"light\"]": {
      "color-scheme": "light",
      "--lunar-bg": "var(--moon-50)",
      "--lunar-bg-elevated": "#ffffff",
      "--lunar-surface": "var(--moon-100)",
      "--lunar-surface-hover": "var(--moon-200)",
      "--lunar-border": "var(--moon-300)",
      "--lunar-text": "var(--moon-950)",
      "--lunar-text-muted": "var(--moon-600)",
      "--lunar-accent": "var(--indigo-600)",
      "--lunar-accent-2": "var(--violet-600)",
      "--eclipse": "var(--moon-100)",
      "--glow": "var(--indigo-500)",
      "--glow-color-sm": "rgb(79 70 229 / calc(0.12 * var(--lunar-moonlight)))",
      "--glow-color-md": "rgb(79 70 229 / calc(0.18 * var(--lunar-moonlight)))",
      "--glow-color-lg": "rgb(79 70 229 / calc(0.22 * var(--lunar-moonlight)))",
      "--glow-color-violet": "rgb(124 58 237 / calc(0.22 * var(--lunar-moonlight)))",
      "--shadow-sm": "0 1px 2px 0 rgb(20 21 42 / 0.06)",
      "--shadow-md": "0 4px 12px -2px rgb(20 21 42 / 0.1), 0 2px 4px -2px rgb(20 21 42 / 0.06)",
      "--shadow-lg": "0 12px 24px -4px rgb(20 21 42 / 0.12), 0 4px 8px -4px rgb(20 21 42 / 0.08)",
      "--shadow-xl": "0 24px 48px -8px rgb(20 21 42 / 0.16), 0 8px 16px -8px rgb(20 21 42 / 0.1)"
    },
    "[data-theme=\"light\"] body": {
      "background-image": "radial-gradient(ellipse 80% 50% at 50% -20%, rgb(99 102 241 / 0.08), transparent), radial-gradient(ellipse 60% 40% at 100% 0%, rgb(124 58 237 / 0.05), transparent)"
    },
    "[data-theme=\"light\"] .starfield::before,\n[data-theme=\"light\"] .starfield::after": {
      "opacity": "0.35"
    },
    "[data-moon-phase=\"new\"]": {
      "--lunar-moonlight": "0.45"
    },
    "[data-moon-phase=\"waxing-crescent\"],\n[data-moon-phase=\"waning-crescent\"]": {
      "--lunar-moonlight": "0.62"
    },
    "[data-moon-phase=\"first-quarter\"],\n[data-moon-phase=\"last-quarter\"]": {
      "--lunar-moonlight": "0.8"
    },
    "[data-moon-phase=\"waxing-gibbous\"],\n[data-moon-phase=\"waning-gibbous\"]": {
      "--lunar-moonlight": "1"
    },
    "[data-moon-phase=\"full\"]": {
      "--lunar-moonlight": "1.25"
    },
    "@property --lunar-angle": {
      "syntax": "'<angle>'",
      "initial-value": "0deg",
      "inherits": "false"
    },
    "@keyframes lunar-float": {
      "0%, 100%": {
        "transform": "translateY(0)"
      },
      "50%": {
        "transform": "translateY(var(--float-distance, -10px))"
      }
    },
    "@keyframes lunar-pulse-glow": {
      "0%, 100%": {
        "box-shadow": "0 0 12px 0 var(--glow-color, var(--glow-color-sm))"
      },
      "50%": {
        "box-shadow": "0 0 48px 6px var(--glow-color, var(--glow-color-lg))"
      }
    },
    "@keyframes lunar-shimmer": {
      "to": {
        "background-position": "-200% center"
      }
    },
    "@keyframes lunar-twinkle": {
      "0%, 100%": {
        "opacity": "0.35"
      },
      "50%": {
        "opacity": "1"
      }
    },
    "@keyframes lunar-aurora": {
      "0%": {
        "background-position": "0% 50%"
      },
      "50%": {
        "background-position": "100% 50%"
      },
      "100%": {
        "background-position": "0% 50%"
      }
    },
    "@keyframes lunar-eclipse-spin": {
      "to": {
        "--lunar-angle": "360deg"
      }
    },
    "@keyframes lunar-fade-in": {
      "from": {
        "opacity": "0"
      },
      "to": {
        "opacity": "1"
      }
    },
    "@keyframes lunar-slide-up": {
      "from": {
        "opacity": "0",
        "transform": "translateY(16px)"
      },
      "to": {
        "opacity": "1",
        "transform": "translateY(0)"
      }
    },
    "@keyframes lunar-scale-in": {
      "from": {
        "opacity": "0",
        "transform": "scale(0.94)"
      },
      "to": {
        "opacity": "1",
        "transform": "scale(1)"
      }
    },
    "@keyframes lunar-scroll-reveal": {
      "from": {
        "opacity": "0"
      },
      "to": {
        "opacity": "1"
      }
    },
    "@keyframes lunar-scroll-reveal-up": {
      "from": {
        "opacity": "0",
        "transform": "translateY(48px)"
      },
      "to": {
        "opacity": "1",
        "transform": "translateY(0)"
      }
    },
    "@keyframes lunar-scroll-reveal-scale": {
      "from": {
        "opacity": "0",
        "transform": "scale(0.88)"
      },
      "to": {
        "opacity": "1",
        "transform": "scale(1)"
      }
    },
    "@keyframes lunar-scroll-reveal-blur": {
      "from": {
        "opacity": "0",
        "filter": "blur(12px)"
      },
      "to": {
        "opacity": "1",
        "filter": "blur(0)"
      }
    },
    "@keyframes lunar-scroll-parallax": {
      "from": {
        "transform": "translateY(48px)"
      },
      "to": {
        "transform": "translateY(-48px)"
      }
    },
    "@keyframes lunar-scroll-grow-x": {
      "from": {
        "transform": "scaleX(0)"
      },
      "to": {
        "transform": "scaleX(1)"
      }
    },
    "@starting-style": {
      ".modal[popover]:popover-open": {
        "opacity": "0",
        "transform": "scale(0.95) translateY(8px)"
      },
      ".modal[popover]:popover-open::backdrop": {
        "background-color": "rgb(9 9 19 / 0)",
        "-webkit-backdrop-filter": "blur(0)",
        "backdrop-filter": "blur(0)"
      }
    },
    "[data-tooltip]": {
      "position": "relative"
    },
    "[data-tooltip]::after,\n[data-tooltip]::before": {
      "opacity": "0",
      "visibility": "hidden",
      "pointer-events": "none",
      "position": "absolute",
      "left": "50%",
      "bottom": "calc(100% + 8px)",
      "transform": "translateX(-50%) translateY(4px)",
      "transition": "opacity var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out)",
      "z-index": "var(--z-tooltip)"
    },
    "[data-tooltip]::after": {
      "content": "attr(data-tooltip)",
      "white-space": "nowrap",
      "padding": "0.375rem 0.625rem",
      "font-size": "var(--text-xs)",
      "font-weight": "var(--font-medium)",
      "color": "var(--tooltip-color, var(--moon-50))",
      "background-color": "var(--tooltip-bg, var(--moon-900))",
      "border-radius": "var(--tooltip-radius, var(--radius-sm))",
      "box-shadow": "var(--shadow-md)"
    },
    "[data-tooltip]::before": {
      "content": "\"\"",
      "bottom": "100%",
      "border": "5px solid transparent",
      "border-top-color": "var(--tooltip-bg, var(--moon-900))"
    },
    "[data-tooltip]:hover::after, [data-tooltip]:hover::before,\n[data-tooltip]:focus-visible::after, [data-tooltip]:focus-visible::before": {
      "opacity": "1",
      "visibility": "visible",
      "transform": "translateX(-50%) translateY(0)"
    }
  },
  "components": {
    ".btn": {
      "--btn-bg": "var(--lunar-surface)",
      "--btn-color": "var(--lunar-text)",
      "--btn-border-color": "transparent",
      "--btn-hover-bg": "var(--btn-bg)",
      "--btn-hover-color": "var(--btn-color)",
      "--btn-hover-border-color": "var(--btn-border-color)",
      "--btn-glow": "0 0 0 0 transparent",
      "--btn-hover-glow": "var(--btn-glow)",
      "--btn-gradient": "none",
      "--btn-radius": "var(--radius-md)",
      "--btn-padding-x": "1.25rem",
      "--btn-padding-y": "0.625rem",
      "--btn-font-size": "var(--text-sm)",
      "--btn-opacity": "1",
      "display": "inline-flex",
      "align-items": "center",
      "justify-content": "center",
      "gap": "var(--space-2)",
      "padding": "var(--btn-padding-y) var(--btn-padding-x)",
      "font-family": "inherit",
      "font-size": "var(--btn-font-size)",
      "font-weight": "var(--font-medium)",
      "line-height": "1",
      "white-space": "nowrap",
      "-webkit-user-select": "none",
      "user-select": "none",
      "border": "1px solid var(--btn-border-color)",
      "border-radius": "var(--btn-radius)",
      "color": "var(--btn-color)",
      "background-color": "var(--btn-bg)",
      "background-image": "var(--btn-gradient)",
      "box-shadow": "var(--btn-glow)",
      "opacity": "var(--btn-opacity)",
      "transition": "background-color var(--duration-base) var(--ease-out), border-color var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out), transform var(--duration-fast) var(--ease-out)",
      "&:hover:not(:disabled), &:focus-visible:not(:disabled)": {
        "background-color": "var(--btn-hover-bg)",
        "border-color": "var(--btn-hover-border-color)",
        "color": "var(--btn-hover-color)",
        "box-shadow": "var(--btn-hover-glow)"
      },
      "&:disabled": {
        "opacity": "0.5",
        "cursor": "not-allowed",
        "box-shadow": "none",
        "transform": "none"
      }
    },
    ".btn-primary": {
      "--btn-bg": "var(--tide)",
      "--btn-color": "var(--moon-50)",
      "--btn-glow": "var(--shadow-glow-sm)",
      "--btn-hover-bg": "var(--indigo-600)",
      "--btn-hover-glow": "var(--shadow-glow-md)",
      "&:hover:not(:disabled), &:focus-visible:not(:disabled)": {
        "transform": "translateY(-1px)"
      }
    },
    ".btn-secondary": {
      "--btn-bg": "var(--lunar-surface)",
      "--btn-border-color": "var(--lunar-border)",
      "--btn-hover-bg": "var(--lunar-surface-hover)"
    },
    ".btn-ghost": {
      "--btn-bg": "transparent",
      "--btn-hover-bg": "var(--lunar-surface)"
    },
    ".btn-outline": {
      "--btn-bg": "transparent",
      "--btn-border-color": "var(--tide)",
      "--btn-color": "var(--tide)",
      "--btn-hover-bg": "rgb(108 111 240 / 0.1)"
    },
    ".btn-glow": {
      "--btn-gradient": "linear-gradient(135deg, var(--tide), var(--violet-500))",
      "--btn-color": "var(--moon-50)",
      "--btn-glow": "var(--shadow-glow-violet)",
      "--btn-hover-glow": "var(--shadow-glow-lg)",
      "&:hover:not(:disabled)": {
        "transform": "translateY(-1px)"
      }
    },
    ".btn-sm": {
      "--btn-padding-x": "0.875rem",
      "--btn-padding-y": "0.375rem",
      "--btn-font-size": "var(--text-xs)"
    },
    ".btn-lg": {
      "--btn-padding-x": "1.75rem",
      "--btn-padding-y": "0.875rem",
      "--btn-font-size": "var(--text-base)"
    },
    ".card": {
      "--card-bg": "var(--lunar-bg-elevated)",
      "--card-border-color": "var(--lunar-border)",
      "--card-hover-border-color": "var(--moon-600)",
      "--card-radius": "var(--radius-lg)",
      "--card-shadow": "var(--shadow-md)",
      "--card-padding-x": "var(--space-6)",
      "--card-padding-y": "var(--space-5)",
      "--card-opacity": "1",
      "background-color": "var(--card-bg)",
      "border": "1px solid var(--card-border-color)",
      "border-radius": "var(--card-radius)",
      "box-shadow": "var(--card-shadow)",
      "opacity": "var(--card-opacity)",
      "overflow": "hidden",
      "transition": "transform var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out), border-color var(--duration-base) var(--ease-out)",
      "&:hover": {
        "border-color": "var(--card-hover-border-color)"
      }
    },
    ".card-header": {
      "padding": "var(--card-padding-y, var(--space-5)) var(--card-padding-x, var(--space-6))",
      "border-bottom": "1px solid var(--card-border-color, var(--lunar-border))",
      "font-weight": "var(--font-semibold)"
    },
    ".card-body": {
      "padding": "var(--card-padding-x, var(--space-6))"
    },
    ".card-footer": {
      "padding": "var(--card-padding-y, var(--space-5)) var(--card-padding-x, var(--space-6))",
      "border-top": "1px solid var(--card-border-color, var(--lunar-border))",
      "display": "flex",
      "align-items": "center",
      "gap": "var(--space-3)"
    },
    ".label": {
      "display": "block",
      "margin-bottom": "var(--space-2)",
      "font-size": "var(--text-sm)",
      "font-weight": "var(--font-medium)",
      "color": "var(--lunar-text-muted)"
    },
    ".input": {
      "--input-bg": "var(--lunar-surface)",
      "--input-color": "var(--lunar-text)",
      "--input-border-color": "var(--lunar-border)",
      "--input-focus-border-color": "var(--tide)",
      "--input-focus-ring-color": "rgb(108 111 240 / 0.25)",
      "--input-radius": "var(--radius-md)",
      "--input-opacity": "1",
      "display": "block",
      "width": "100%",
      "padding": "0.625rem 0.875rem",
      "font-family": "inherit",
      "font-size": "var(--text-sm)",
      "color": "var(--input-color)",
      "background-color": "var(--input-bg)",
      "border": "1px solid var(--input-border-color)",
      "border-radius": "var(--input-radius)",
      "opacity": "var(--input-opacity)",
      "transition": "border-color var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out)",
      "&::placeholder": {
        "color": "var(--lunar-text-muted)"
