      "&:focus": {
        "outline": "none",
        "border-color": "var(--input-focus-border-color)",
        "box-shadow": "0 0 0 3px var(--input-focus-ring-color), var(--shadow-glow-sm)"
      },
      "&:disabled": {
        "opacity": "0.5",
        "cursor": "not-allowed"
      }
    },
    ".textarea": {
      "--input-bg": "var(--lunar-surface)",
      "--input-color": "var(--lunar-text)",
      "--input-border-color": "var(--lunar-border)",
      "--input-focus-border-color": "var(--tide)",
      "--input-focus-ring-color": "rgb(108 111 240 / 0.25)",
      "--input-radius": "var(--radius-md)",
      "--input-opacity": "1",
      "display": "block",
      "width": "100%",
      "padding": "0.625rem 0.875rem",
      "font-family": "inherit",
      "font-size": "var(--text-sm)",
      "color": "var(--input-color)",
      "background-color": "var(--input-bg)",
      "border": "1px solid var(--input-border-color)",
      "border-radius": "var(--input-radius)",
      "opacity": "var(--input-opacity)",
      "transition": "border-color var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out)",
      "&::placeholder": {
        "color": "var(--lunar-text-muted)"
      },
      "&:focus": {
        "outline": "none",
        "border-color": "var(--input-focus-border-color)",
        "box-shadow": "0 0 0 3px var(--input-focus-ring-color), var(--shadow-glow-sm)"
      },
      "&:disabled": {
        "opacity": "0.5",
        "cursor": "not-allowed"
      },
      "min-height": "6rem",
      "resize": "vertical"
    },
    ".select": {
      "--input-bg": "var(--lunar-surface)",
      "--input-color": "var(--lunar-text)",
      "--input-border-color": "var(--lunar-border)",
      "--input-focus-border-color": "var(--tide)",
      "--input-focus-ring-color": "rgb(108 111 240 / 0.25)",
      "--input-radius": "var(--radius-md)",
      "--input-opacity": "1",
      "display": "block",
      "width": "100%",
      "padding": "0.625rem 0.875rem",
      "font-family": "inherit",
      "font-size": "var(--text-sm)",
      "color": "var(--input-color)",
      "background-color": "var(--input-bg)",
      "border": "1px solid var(--input-border-color)",
      "border-radius": "var(--input-radius)",
      "opacity": "var(--input-opacity)",
      "transition": "border-color var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out)",
